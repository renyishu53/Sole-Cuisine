# =============================================================================
# SoloChef Docker 部署环境变量模板
#
# 使用方法:
#   1. 复制此文件为 .env:  cp .env.docker.example .env
#   2. 修改其中的敏感值 (密码、API Key 等)
#   3. 启动: docker compose up -d
#
# docker-compose.yml 中的 ${VAR:-default} 会优先读取此文件，
# 未设置时使用默认值。
#
# 注意: 容器内的 DATABASE_URL / REDIS_URL / NEO4J_URI / MILVUS_HOST 等
# 连接串已由 docker-compose.yml 的 environment 节强制覆盖为容器服务名，
# 此文件无需 (也不应) 配置它们。
# =============================================================================

# ── PostgreSQL / Neo4j ──
POSTGRES_DB=solochef
POSTGRES_USER=solochef
POSTGRES_PASSWORD=solochef_password
NEO4J_PASSWORD=solochef_password

# ── 对外端口 ──
# 前端 Nginx 监听端口（生产默认 80，被占用时改其他端口）
FRONTEND_PORT=80

# ── 应用环境 ──
APP_ENV=production

# ── RAG 检索开关（两阶段部署的核心开关）────────────────────────────
# 阶段1 · 2核4G 服务器: 保持 false —— 不启动 Milvus/Neo4j（省约 3G 内存），
#   知识库功能关闭，注册登录/周计划/菜谱/AI聊天 正常
# 阶段2 · 升级 4核8G+: 改为 true，并配置下方模型目录，然后执行
#   docker compose --profile rag up -d
RAG_ENABLED=false

# ── AI 模型目录（阶段2 启用，需 RAG_ENABLED=true）──────────────────
# 指向服务器上的本地模型目录，容器内挂载为 /models/*：
#   BGE_M3_MODEL_DIR: BGE-M3 语义向量模型（稠密+稀疏检索）约 2.3G
#   RERANK_MODEL_DIR: bge-reranker-v2-m3 精排模型（二阶段重排）约 2.2G
# 模型文件需预先上传到服务器（如 /opt/solochef/models/...），
# 代码不会在容器内隐式下载。留空则对应能力自动降级，不影响启动。
# 例:
#   BGE_M3_MODEL_DIR=/opt/solochef/models/bge-m3
#   RERANK_MODEL_DIR=/opt/solochef/models/bge-reranker-v2-m3
BGE_M3_MODEL_DIR=
RERANK_MODEL_DIR=

# ── RAG 检索参数（阶段2 按需调整）──
RAG_TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=100
EMBEDDING_DEVICE=cpu
RERANK_DEVICE=cpu

# ── LLM 配置 (生产环境请填入真实 Key) ──
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_SECONDS=60
AI_FALLBACK_ENABLED=true

# ── Agent 能力开关 (生产环境按需开启) ──
CHAT_AGENT_ENABLED=false
CHAT_AGENT_MAX_ITERATIONS=6
CHAT_AGENT_TOOL_TIMEOUT_SECONDS=8
WORKFLOW_SUPERVISOR_ENABLED=false
SUPERVISOR_MAX_ROUNDS=2
SUPERVISOR_MAX_DISPATCHES_PER_ROUND=4
SUPERVISOR_MAX_TOTAL_DISPATCHES=6
TOOL_WEBSEARCH_ENABLED=false
TOOL_WEBSEARCH_PROVIDER=tavily
TOOL_WEBSEARCH_API_KEY=
TOOL_WEBSEARCH_TIMEOUT_SECONDS=8
ENTITY_EXTRACTION_LLM_ENABLED=false

# ── JWT 鉴权 (生产环境务必修改 secret!) ──
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=solochef-api
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ── CORS ──
# 前端经 Nginx 同源反代访问后端，默认配置即可；
# 如有其他前端来源（如本地开发调试）按需追加
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── 阿里云短信 (登录注册需要) ──
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=恒创联众
SMS_TEMPLATE_LOGIN=100001
SMS_TEMPLATE_CHANGE_PHONE=100002
SMS_TEMPLATE_RESET_PASSWORD=100003
SMS_TEMPLATE_BIND_PHONE=100004
SMS_TEMPLATE_VERIFY_PHONE=100005
SMS_CODE_EXPIRE_MINUTES=5
SMS_SEND_INTERVAL_SECONDS=60

# ── LangGraph checkpoint 持久化 ──
CHECKPOINT_RETENTION_DAYS=7
