# Backend
APP_ENV=development
DATABASE_URL=mysql+aiomysql://solochef:solochef_password@localhost:3306/solochef
MYSQL_DB=solochef
MYSQL_USER=solochef
MYSQL_PASSWORD=solochef_password
MYSQL_ROOT_PASSWORD=solochef_root
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=solochef_password
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=solochef_knowledge
RAG_ENABLED=true
RAG_TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=100
# Semantic embedding model: auto | bge-m3 | default
# BGE-M3 requires sentence-transformers plus a pre-downloaded model (HF cache
# or EMBEDDING_MODEL_PATH). Falls back to the built-in lightweight model when
# unavailable.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_PATH=
EMBEDDING_DEVICE=cpu
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_SECONDS=60
AI_FALLBACK_ENABLED=true
# Keep startup deterministic. Set true only after verifying the configured LLM
# consistently returns JSON for graph entity extraction.
ENTITY_EXTRACTION_LLM_ENABLED=false
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=solochef-api
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Alibaba Cloud SMS (required for SMS login and registration)
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=恒创联众
SMS_TEMPLATE_LOGIN=100001
SMS_TEMPLATE_CHANGE_PHONE=100002
SMS_TEMPLATE_RESET_PASSWORD=100003
SMS_TEMPLATE_BIND_PHONE=100004
SMS_TEMPLATE_VERIFY_PHONE=100005
SMS_CODE_EXPIRE_MINUTES=5
SMS_SEND_INTERVAL_SECONDS=60

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
