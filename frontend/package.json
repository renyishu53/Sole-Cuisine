{
  "name": "solochef-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vueuse/core": "^13.6.0",
    "axios": "^1.11.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.14.4",
    "lucide-vue-next": "^0.536.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.0.4"
  }
}
